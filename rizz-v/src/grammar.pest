program = {line+}
line = {directive? ~ label? ~ instruction? ~ NEWLINE+}
directive = ${"." ~ ident ~ WHITESPACE+ ~ ident}
label = {ident ~ ":"}
ident = {(ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*}
instruction = {cmd ~ operands?}
cmd = @{ASCII_ALPHA+}
operands = _{operand+}
operand = {r_operand | i_operand | binary_operand | binary_imm_operand |(ASCII_DIGIT+ ~ register)}
operand_imm = {ASCII_DIGIT+}
r_operand = { register ~ "," ~ register ~ "," ~ register }
i_operand = { register ~ "," ~ register ~ "," ~ operand_imm }
binary_operand = {register ~ "," ~ register}
binary_imm_operand = {register ~ "," ~ operand_imm}
register = {( reg_type ~ ASCII_DIGIT{1, 2} ) | "fp" | "ra"}
reg_type = {"s" | "t" | "a"}
WHITESPACE = _{" " | "\t"}
NEWLINE = {"\n" | "\r\n" | "\r"}
COMMENT = _{"#" ~ ASCII_ALPHANUMERIC* ~ NEWLINE}
