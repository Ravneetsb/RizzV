program = { SOI ~ line* ~ EOI }
line = { SPACE* ~ statement? ~ SPACE* ~ comment? ~ NEWLINE+ }
statement = { directive | labeled_instruction | label | instruction }
labeled_instruction = { label ~ SPACE* ~ instruction? }
directive = ${ "." ~ ident ~ SPACE+ ~ ident }
label = { ident ~ ":" }
instruction = { cmd ~ (SPACE+ ~ operands)? }
cmd = @{ ASCII_ALPHA+ }
operands = { memory_operand | r_operand | branch_operand | i_operand | label_operand | binary_operand | binary_imm_operand }
memory_operand = { register ~ "," ~ SPACE* ~ memory_address }
memory_address = { operand_imm? ~ "(" ~ register ~ ")" }
branch_operand = { register ~ "," ~ SPACE* ~ register ~ "," ~ SPACE* ~ label_ident }
label_operand = { register ~ "," ~ SPACE* ~ label_ident | label_ident }
r_operand = { register ~ "," ~ SPACE* ~ register ~ "," ~ SPACE* ~ register }
i_operand = { register ~ "," ~ SPACE* ~ register ~ "," ~ SPACE* ~ operand_imm }
binary_operand = { register ~ "," ~ SPACE* ~ register }
binary_imm_operand = { register ~ "," ~ SPACE* ~ operand_imm }
operand_imm = { "-"? ~ ASCII_DIGIT+ }
register = @{ ((reg_type ~ ASCII_DIGIT{1, 2}) | "fp" | "ra" | "sp" | "zero") ~ !(ASCII_ALPHANUMERIC | "_") }
reg_type = { "s" | "t" | "a" }
ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
label_ident = @{ !register ~ ident }
comment = _{ "#" ~ (!NEWLINE ~ ANY)* }
SPACE = _{ " " | "\t" }
NEWLINE = _{ "\n" | "\r\n" | "\r" }
